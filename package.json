{
  "name": "close-powerlifting",
  "version": "0.0.1",
  "description": "An in-memory REST API mirroring the OpenPowerlifting dataset",
  "keywords": [
    "powerlifting"
  ],
  "license": "MIT",
  "author": "wajeht",
  "main": "dist/src/server.js",
  "scripts": {
    "start": "export APP_ENV=production && node --no-warnings --max-old-space-size=12288 ./dist/src/server.js",
    "dev": "concurrently --kill-others --names \"EXPRESS,TAILWIND\" -c \"bgGreen.black,bgCyan.black\" \"npm run dev:api\" \"npm run dev:tailwind\"",
    "dev:only": "export APP_ENV=development && tsx watch --no-warnings --clear-screen=false ./src/server.ts",
    "dev:api": "export APP_ENV=development && exec tsx watch --no-warnings --clear-screen=false ./src/server.ts",
    "dev:tailwind": "npx @tailwindcss/cli -i ./public/css/tailwind.css -o ./public/css/style.css --watch",
    "build": "npm run build:tailwind:minify && npm run build:server",
    "build:prod": "npm run build && npm run minify",
    "build:server": "rm -rf ./dist && tsgo",
    "build:tailwind": "rm ./public/css/style.css && npx @tailwindcss/cli -i ./public/css/tailwind.css -o ./public/css/style.css",
    "build:tailwind:minify": "rm ./public/css/style.css && npx @tailwindcss/cli -i ./public/css/tailwind.css -o ./public/css/style.css --minify",
    "minify": "tsx scripts/minify.ts",
    "update:deps": "npx npm-check -u",
    "check:deps": "npx depcheck",
    "rebuild:native": "npm rebuild sharp --ignore-scripts=false",
    "test:watch": "APP_ENV=testing NODE_ENV=testing NODE_NO_WARNINGS=1 vp test watch",
    "test": "APP_ENV=testing NODE_ENV=testing NODE_NO_WARNINGS=1 vp test",
    "test:coverage": "APP_ENV=testing NODE_ENV=testing vp test --coverage",
    "test:ci": "APP_ENV=testing NODE_ENV=testing vp test --coverage.enabled --coverage.reporter='text-summary'",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "format:check": "vp fmt --check .",
    "format": "vp fmt --write . > /dev/null",
    "format:verbose": "vp fmt --write .",
    "lint:check": "vp lint .",
    "lint": "vp lint --fix .",
    "rmds": "find . -name '.DS_Store' -delete",
    "generate:og": "tsx ./scripts/generate-og-image.ts",
    "optimize:images": "tsx ./scripts/optimize-images.ts",
    "prepare": "[ -z \"$CI\" ] && vp config || true"
  },
  "dependencies": {
    "@tailwindcss/cli": "4.3.0",
    "compression": "1.8.1",
    "concurrently": "9.2.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "csv-parse": "6.2.1",
    "dotenv": "17.4.2",
    "eta": "4.6.0",
    "express": "5.2.1",
    "express-jsdoc-swagger": "1.8.0",
    "express-rate-limit": "8.5.2",
    "helmet": "8.1.0",
    "node-cron": "4.2.1",
    "tailwindcss": "4.3.0",
    "unzipper": "0.12.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/html-minifier-terser": "7.0.2",
    "@types/node": "25.8.0",
    "@types/node-cron": "3.0.11",
    "@types/supertest": "7.2.0",
    "@types/unzipper": "0.10.11",
    "@typescript/native-preview": "7.0.0-dev.20260516.1",
    "@vitest/coverage-v8": "4.1.5",
    "@wajeht/express-templates-reload": "3.0.0",
    "html-minifier-terser": "7.2.0",
    "satori": "0.26.0",
    "sharp": "0.34.5",
    "supertest": "7.2.2",
    "terser": "5.47.1",
    "tsx": "4.22.0",
    "vite-plus": "0.1.21",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.21"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.21",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.21"
  },
  "engines": {
    "node": ">=26.1.0",
    "npm": ">=11.13.0"
  },
  "packageManager": "npm@11.14.0"
}
