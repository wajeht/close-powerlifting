{
  "compilerOptions": {
    /* Base Options: */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "removeComments": true,

    /* JSX for hono/jsx templates */
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",

    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* If transpiling with TypeScript: */
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "outDir": "dist",
    "rootDir": "./",
    "sourceMap": true,

    /* DOM types provide typed fetch/Response shapes used by the HTTP layer */
    "lib": ["es2022", "DOM"]
  },
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.mts",
    "**/*.test.mjs",
    "**/*.test.js",
    "**/*.spec.ts",
    "src/tests/**/*",
    "dist",
    "coverage",
    "public",
    "vite.config.mts"
  ]
}
