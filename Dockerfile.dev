FROM node:26.13.1-slim@sha256:e6bedef217677b276c591795e169840edd9096dbf13f29df8ef8d1856b8820bc

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN cd /tmp && npm install --global npm@11.17.0

WORKDIR /usr/src/app

COPY package.json package-lock.json .npmrc ./

RUN npm install && \
    npm rebuild sharp --ignore-scripts=false

COPY ./ ./

EXPOSE 80

CMD ["npm", "run", "dev"]

HEALTHCHECK CMD curl -f http://localhost:80/healthz || exit 1
